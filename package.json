{
  "name": "lmt_unified_dashboard",
  "version": "1.0.0",
  "description": "LMT Unified Dashboard to show benchmarking results",
  "main": "dist/js/lmtud_bundle.min.js",
  "scripts": {
    "build": "npm run build:js && npm run build:css && npm run build:static",
    "build:js": "vite build",
    "build:css": "tailwindcss -i ./assets/css/lmtstyle.css -o ./dist/css/lmtud_bundle.min.css --minify",
    "build:static": "node scripts/copy-static.mjs",
    "licenses": "node scripts/licenses.mjs",
    "build:all": "npm run build && npm run licenses",
    "watch:js": "vite build --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/climatemodeling/unified-dashboard.git"
  },
  "keywords": [
    "dashboard",
    "model",
    "benchmarking",
    "earth",
    "system",
    "models"
  ],
  "author": {
    "name": "Min Xu, the ORNL Land Model Testbed LDRD project, and US Department of Energy RUBISCO Science Focus Area",
    "url": "https://github.com/climatemodeling/unified-dashboard.git"
  },
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/climatemodeling/unified-dashboard/issues"
  },
  "homepage": "https://github.com/climatemodeling/unified-dashboard#readme",
  "dependencies": {
    "choices.js": "^10.2.0",
    "dom-to-image": "^2.6.0",
    "slideout": "^1.0.1",
    "tabulator-tables": "^6.2.1"
  },
  "devDependencies": {
    "license-checker": "^25.0.1",
    "vite": "^8.3.5",
    "tailwindcss": "^3.4.17"
  }
}
